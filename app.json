{
	"version": "1.88",
	"label": "app.name",
	"classes": ["game"],
	"paths": ["chess"],
	"services": ["chess"],

	"architecture": {"engine": "starlark", "version": 4},
	"execute": ["chess.star"],

	"database": {
		"schema": 4,
		"file": "chess.db",
		"create": {"function": "database_create"},
		"upgrade": {"function": "database_upgrade"},
	},

	"icons": [
		{"action": "", "label": "app.name", "file": "images/icon.svg"}
	],

	"actions": {
		"": {"file": "web/dist/index.html"},
		"assets": {"files": "web/dist/assets"},
		"images": {"files": "web/dist/images"},
		"-/create": {"function": "action_create"},
		"-/list": {"function": "action_list"},
		"-/new": {"function": "action_new"},

		":game": {"file": "web/dist/index.html"},
		":game/-/view": {"function": "action_view"},
		":game/-/messages": {"function": "action_messages"},
		":game/-/send": {"function": "action_send"},
		":game/-/move": {"function": "action_move"},
		":game/-/user/:user/asset/:asset": {"function": "action_user_asset", "public": true},
		":game/-/resign": {"function": "action_resign"},
		":game/-/draw-offer": {"function": "action_draw_offer"},
		":game/-/draw-accept": {"function": "action_draw_accept"},
		":game/-/draw-decline": {"function": "action_draw_decline"},
		":game/-/delete": {"function": "action_delete"},
		":game/assets": {"files": "web/dist/assets"},
		":game/images": {"files": "web/dist/images"}
	},

	"events": {
		"new": {"function": "event_new"},
		"move": {"function": "event_move"},
		"message": {"function": "event_message"},
		"resign": {"function": "event_resign"},
		"sync": {"function": "event_sync"},
		"draw_offer": {"function": "event_draw_offer"},
		"draw_accept": {"function": "event_draw_accept"},
		"draw_decline": {"function": "event_draw_decline"}
	}
}
